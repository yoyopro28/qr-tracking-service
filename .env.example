# Browser-safe Vite settings (the publishable key is intentionally public).
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="replace-with-local-publishable-key"
VITE_TRACKING_ORIGIN="http://127.0.0.1:8787"
# Optional MapLibre style URL. Without it, the UI shows a privacy-friendly coordinate map.
VITE_MAP_STYLE_URL=""

# Cache-sync Worker secrets: set with `wrangler secret put`, never expose to Vite.
SUPABASE_SECRET_KEY="replace-only-in-.dev.vars-or-worker-secret"
SYNC_WEBHOOK_SECRET="replace-only-in-.dev.vars-or-worker-secret"

# Redirect Worker secret.
HMAC_SECRET="replace-only-in-.dev.vars-or-worker-secret"

# Supabase Edge Function secrets.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
CLOUDFLARE_ACCOUNT_ID="replace-in-supabase-secrets"
CLOUDFLARE_ANALYTICS_READ_TOKEN="replace-in-supabase-secrets"
CLOUDFLARE_ANALYTICS_DATASET="qr_scans"
ROLLUP_CRON_SECRET="replace-in-supabase-secrets"
MAINTENANCE_CRON_SECRET="replace-in-supabase-secrets"
