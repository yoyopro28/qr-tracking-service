{
  "name": "qr-tracking-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "node scripts/check-browser-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:types": "wrangler types --include-runtime false --config workers/redirect/wrangler.jsonc workers/redirect/src/worker-configuration.d.ts && wrangler types --include-runtime false --config workers/cache-sync/wrangler.jsonc workers/cache-sync/src/worker-configuration.d.ts",
    "worker:check": "npm run worker:types && tsc -p workers/redirect/tsconfig.json --noEmit && tsc -p workers/cache-sync/tsconfig.json --noEmit",
    "worker:dry-run": "wrangler deploy --dry-run --env=\"\" && wrangler deploy --dry-run --env=\"\" --config workers/redirect/wrangler.jsonc && wrangler deploy --dry-run --env=\"\" --config workers/cache-sync/wrangler.jsonc",
    "deploy:validate": "node scripts/validate-deployment-config.mjs",
    "deploy:configure-workers": "node scripts/configure-worker-secrets.mjs",
    "deploy:configure-runtime": "node scripts/configure-runtime-integrations.mjs",
    "deploy:smoke": "node scripts/smoke-deployment.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:lint": "supabase db lint --local --schema public --level error --fail-on error",
    "supabase:types": "supabase gen types typescript --local > src/infrastructure/supabase/database.types.ts",
    "cache:reconcile": "node scripts/reconcile-cache.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@zxing/browser": "^0.2.1",
    "maplibre-gl": "^6.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "supabase": "^2.116.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.1"
  }
}
