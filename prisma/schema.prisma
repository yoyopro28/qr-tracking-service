generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FlyerStatus {
  GENERATED
  PRINTED
  ACTIVATED
  RETIRED
}

enum ActivationSource {
  ADMIN_SCAN
  MANUAL_ADMIN_ENTRY
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String?
  passwordHash      String?           @map("password_hash")
  externalAuthId    String?           @map("external_auth_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  workspaceMembers  WorkspaceMember[]
  activations       Activation[]

  @@map("users")
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  members          WorkspaceMember[]
  campaigns        Campaign[]
  templates        Template[]
  flyers           Flyer[]
  locations        Location[]
  activations      Activation[]
  scanEvents       ScanEvent[]

  @@map("workspaces")
}

model WorkspaceMember {
  id           String        @id @default(cuid())
  workspaceId  String        @map("workspace_id")
  userId       String        @map("user_id")
  role         WorkspaceRole @default(OWNER)
  createdAt    DateTime      @default(now()) @map("created_at")
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String         @map("workspace_id")
  name           String
  description    String?
  destinationUrl String         @map("destination_url")
  status         CampaignStatus @default(DRAFT)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templates      Template[]
  flyers         Flyer[]
  locations      Location[]
  scanEvents     ScanEvent[]

  @@index([workspaceId])
  @@map("campaigns")
}

model Template {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  campaignId        String    @map("campaign_id")
  originalFilename  String    @map("original_filename")
  storageKey        String    @map("storage_key")
  mimeType          String    @map("mime_type")
  fileSizeBytes     Int       @map("file_size_bytes")
  pageCount         Int       @map("page_count")
  width             Decimal?  @db.Decimal(10, 2)
  height            Decimal?  @db.Decimal(10, 2)
  qrPageNumber      Int?      @map("qr_page_number")
  qrX               Decimal?  @map("qr_x") @db.Decimal(10, 2)
  qrY               Decimal?  @map("qr_y") @db.Decimal(10, 2)
  qrWidth           Decimal?  @map("qr_width") @db.Decimal(10, 2)
  qrHeight          Decimal?  @map("qr_height") @db.Decimal(10, 2)
  qrPlacements      Json?     @map("qr_placements")
  shortTextEnabled  Boolean   @default(false) @map("short_text_enabled")
  shortTextOffsetX  Decimal?  @map("short_text_offset_x") @db.Decimal(10, 2)
  shortTextOffsetY  Decimal?  @map("short_text_offset_y") @db.Decimal(10, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  flyers            Flyer[]

  @@index([workspaceId])
  @@index([campaignId])
  @@map("templates")
}

model Flyer {
  id                     String       @id @default(cuid())
  workspaceId            String       @map("workspace_id")
  campaignId             String       @map("campaign_id")
  templateId             String       @map("template_id")
  shortcode              String       @unique
  trackingUrl            String       @map("tracking_url")
  status                 FlyerStatus  @default(GENERATED)
  generatedPdfStorageKey String?      @map("generated_pdf_storage_key")
  generatedAt            DateTime?    @map("generated_at")
  activatedAt            DateTime?    @map("activated_at")
  retiredAt              DateTime?    @map("retired_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  workspace              Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign               Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template               Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  activations            Activation[]
  scanEvents             ScanEvent[]

  @@index([workspaceId])
  @@index([campaignId])
  @@index([templateId])
  @@map("flyers")
}

model Location {
  id            String       @id @default(cuid())
  workspaceId   String       @map("workspace_id")
  campaignId    String?      @map("campaign_id")
  name          String
  description   String?
  addressLine1  String?      @map("address_line_1")
  addressLine2  String?      @map("address_line_2")
  postalCode    String?      @map("postal_code")
  city          String?
  country       String?
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activations   Activation[]
  scanEvents    ScanEvent[]

  @@index([workspaceId])
  @@index([campaignId])
  @@map("locations")
}

model Activation {
  id                String           @id @default(cuid())
  workspaceId       String           @map("workspace_id")
  flyerId           String           @map("flyer_id")
  locationId        String           @map("location_id")
  activatedByUserId String?          @map("activated_by_user_id")
  source            ActivationSource
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flyer             Flyer            @relation(fields: [flyerId], references: [id], onDelete: Cascade)
  location          Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  activatedByUser   User?            @relation(fields: [activatedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([flyerId])
  @@index([locationId])
  @@map("activations")
}

model ScanEvent {
  id               String     @id @default(cuid())
  workspaceId      String     @map("workspace_id")
  flyerId          String     @map("flyer_id")
  campaignId       String     @map("campaign_id")
  locationId       String?    @map("location_id")
  occurredAt       DateTime   @default(now()) @map("occurred_at")
  ipHash           String?    @map("ip_hash")
  userAgent        String?    @map("user_agent")
  referer          String?
  countryCode      String?    @map("country_code")
  isUniqueEstimate Boolean    @default(false) @map("is_unique_estimate")
  createdAt        DateTime   @default(now()) @map("created_at")
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flyer            Flyer      @relation(fields: [flyerId], references: [id], onDelete: Cascade)
  campaign         Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location         Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([flyerId])
  @@index([campaignId])
  @@index([locationId])
  @@index([occurredAt])
  @@map("scan_events")
}
